{
  "name": "wp-performance/deaktiver",
  "description": "",
  "keywords": ["wordpress", "plugin"],
  "homepage": "https://github.com/WP-Performance/deaktiver",
  "authors": [
    {
      "name": "Faramaz Patrick",
      "homepage": "https://wp-performance.com"
    }
  ],
  "type": "wordpress-plugin",
  "require": {
    "php": "^8.0",
    "wp-performance/presswind-assets": "dev-main"
  },
    "autoload": {
        "psr-4": {
        "Deaktiver\\": "src/"
        }
    },
  "require-dev": {},
  "extra": {
    "mozart": {
      "dep_namespace": "Deaktiver\\Dependencies\\",
      "dep_directory": "/src/Dependencies/",
      "classmap_directory": "/src/",
      "classmap_prefix": "DKTR_",
      "packages": [
        "wp-performance/presswind-assets"
      ],
      "excluded_packages": [
      ],
      "delete_vendor_directories": true
    }
  },
  "scripts": {
  "test": "php tests/DeaktivePostsResolveTest.php",
  "post-install-cmd": [
    "mozart compose",
    "composer dump-autoload"
  ],
  "post-update-cmd": [
    "mozart compose",
    "composer dump-autoload"
  ]
}
}
